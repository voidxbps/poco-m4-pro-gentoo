#!/bin/sh
mkdir -p /dev/socket
chmod 755 /dev/socket
mknod /dev/urandom c 1 9 2>/dev/null
mknod /dev/random c 1 8 2>/dev/null
mknod /dev/null c 1 3 2>/dev/null
mknod /dev/zero c 1 5 2>/dev/null
cat /proc/1/cmdline > /gentoo-pid1.txt
export LD_LIBRARY_PATH=/system/lib64:/system/lib64/hw
/system/bin/adbd >/var/log/adbd.log 2>&1 &
